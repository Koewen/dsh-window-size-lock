{
  "name": "dsh-window-size-lock",
  "version": "1.3.0",
  "description": "Lock and persist the DeepSeek Harness main window size: restore the last size on every launch (beating the default layout) and adopt stable user resizes as the new lock, via user32.dll (koffi) from the host plugin process.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "WorkBuddy",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "window-size",
    "resize",
    "persist"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.2.1-rc.3",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
